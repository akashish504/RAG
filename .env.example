# Copy to .env and fill in. Never commit .env.

# Environment
MCP_ENV=dev
AWS_REGION=eu-west-1
AWS_ACCOUNT_ID=
AWS_PROFILE=

# S3 document/object store
S3_BUCKET=claude-mcp-object-store
S3_BUCKET_ARN=arn:aws:s3:::claude-mcp-object-store
S3_PREFIX=raw/
S3_TEST_KEY=sample.txt

# SQS pipeline trigger
SQS_QUEUE_NAME=claude-mcp-sqs
SQS_QUEUE_URL=https://sqs.eu-west-1.amazonaws.com/<account-id>/claude-mcp-sqs
SQS_QUEUE_ARN=arn:aws:sqs:eu-west-1:<account-id>:claude-mcp-sqs
# SQS worker tuning
SQS_VISIBILITY_TIMEOUT=300
SQS_WAIT_TIME_SECONDS=20
SQS_MAX_MESSAGES=10
# Attempts before a queued record is marked dead in the S3 job ledger
# (_pipeline_state/jobs/ — the DLQ substitute; see scripts/run_worker.py)
WORKER_MAX_ATTEMPTS=5

# EC2 deployment
EC2_INSTANCE_ID=
EC2_HOST=
EC2_IAM_ROLE_ARN=arn:aws:iam::<account-id>:role/mcp-dev-ec2-role

# PostgreSQL / RDS
POSTGRES_DB_IDENTIFIER=mcp-dev-rds-db-eu
POSTGRES_ENGINE=postgresql
POSTGRES_REGION=eu-west-1
POSTGRES_AZ=eu-west-1a
POSTGRES_INSTANCE_CLASS=db.t3.micro
POSTGRES_HOST=mcp-dev-rds-db-eu.cxuue20kukve.eu-west-1.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_DB=dalbergmcprdsdb
POSTGRES_USER=dalbergrdsadmin
POSTGRES_PASSWORD=

# OpenSearch
OPENSEARCH_DOMAIN_NAME=mcp-dev-os-search-eu
OPENSEARCH_DOMAIN_ARN=arn:aws:es:eu-west-1:<account-id>:domain/mcp-dev-os-search-eu
OPENSEARCH_ENDPOINT=https://vpc-mcp-dev-os-search-eu-wpkqzgri7dpehi74tybzbnmx5u.eu-west-1.es.amazonaws.com
OPENSEARCH_DASHBOARDS_URL=https://vpc-mcp-dev-os-search-eu-wpkqzgri7dpehi74tybzbnmx5u.eu-west-1.es.amazonaws.com/_dashboards
OPENSEARCH_INDEX=mcp-docs
# Leave blank to use SigV4 (IAM role on EC2); set both for basic-auth dev access
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# Voyage embedder
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4
VOYAGE_EMBED_DIMS=1024

# HTTP API (FastAPI behind Nginx — see Dockerfile.api)
# Long-lived secret; send as: Authorization: Bearer <value>
API_BEARER_TOKEN=
# Host port when using docker compose api service (container still listens on 80 inside)
API_HOST_PORT=8080

# Microsoft Entra ID OAuth — MCP server sign-in (/mcp/v2/ via claude.ai connector)
# From the Entra ID App Registration (devops-provisioned "Dalberg MCP Server").
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# HMAC signing secret for self-contained MCP access tokens (any high-entropy
# random string, e.g. `openssl rand -hex 32`). Rotate to invalidate all
# outstanding access tokens at once.
MCP_OAUTH_SIGNING_SECRET=
# Public HTTPS base URL this API is reachable at, no trailing slash (e.g.
# https://mcp.dev.dalberg.com). Used to derive the OAuth issuer URL
# (<base>/mcp/v2) and the Microsoft redirect_uri (<base>/oauth/callback) —
# the latter MUST exactly match the redirect URI registered on the Entra ID
# App Registration.
MCP_PUBLIC_BASE_URL=

# S3 citations
# Underlying presigned-URL lifetime (seconds) — used by the /cite redirect.
S3_CITATION_EXPIRY_SECONDS=3600
# Short citation links: when BOTH are set, citation_url becomes
#   <CITATION_PUBLIC_BASE_URL>/cite/<token>  (~70 chars)
# instead of a giant raw presigned URL. Leave blank to keep raw presigned URLs.
CITATION_SIGNING_SECRET=
CITATION_PUBLIC_BASE_URL=
# How long a /cite link stays valid (seconds). Default 24h. Rotate the secret to revoke all.
CITATION_LINK_TTL_SECONDS=86400
# Allow ?download=1 proxy/stream mode on /cite (1=on). Redirect is always available.
CITATION_PROXY_ENABLED=1

# High-fidelity document extraction (llm_content normalizer — PDF/PPTX/images → S3 __normalized.txt)
# Default model is Sonnet for visual/chart fidelity; Haiku only if you override explicitly.
# Haiku by default (fast/cheap). Use claude-sonnet-4-6 for max fidelity on
# chart/diagram/map-heavy documents.
CONTENT_NORMALIZER_MODEL=claude-haiku-4-5-20251001
CONTENT_NORMALIZER_MAX_OUTPUT_TOKENS=32768
CONTENT_NORMALIZER_PAGE_BATCH_SIZE=10
CONTENT_NORMALIZER_SINGLE_CALL_MAX_PAGES=10

# slides_deck normalizer (D-Quals PPTX): python-pptx parser (free) + ONE Haiku call
# with ALL visual slide images + one deck summary. Set SLIDES_ENRICH_SINGLE_CALL=false
# and SLIDES_BATCH_SIZE=20 to revert to batched Sonnet-style enrichment.
SLIDES_ENRICH_MODEL=claude-haiku-4-5-20251001
SLIDES_ENRICH_SINGLE_CALL=true
SLIDES_BATCH_SIZE=20

# Claude API — NL → Airtable query planning (Messages API; default model Sonnet 4.6)
ANTHROPIC_API_KEY=
# Optional: CLAUDE_API_KEY, ANTHROPIC_MODEL / CLAUDE_MODEL, ANTHROPIC_MAX_OUTPUT_TOKENS
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_OUTPUT_TOKENS=2048
# Second pass: plain-language answer + markdown_table in API/MCP JSON (set false to save tokens)
ANTHROPIC_NL_READABLE_ANSWER=true

# Pipeline tuning
LOG_LEVEL=INFO
CHUNK_BATCH_SIZE=256
EMBED_BATCH_SIZE=32

# Airtable — MCP tools and GET /v1/test/airtable/* (also used by ingestion when extras installed)
# PAT: https://airtable.com/create/tokens — scopes: data.records:read (and schema.bases:read for metadata)
AIRTABLE_PAT_TOKEN=
# Base ID from the API or base URL (starts with app...)
BASE_ID=
# Exact table name as shown in Airtable (default in code: Dalberg Profiles)
TABLE_NAME=Dalberg Profiles
# Optional tbl... id (overrides name lookup when set)
TABLE_ID=
# Aliases: AIRTABLE_BASE_ID, AIRTABLE_TABLE_NAME, AIRTABLE_TABLE_ID
# Frozen schema JSON for planner / get_schema (optional if PAT has schema.bases:read).
# If missing at startup, retrieval fetches table schema from Airtable Meta API once and
# may write this file (see AIRTABLE_SCHEMA_AUTO_SAVE). Regenerate manually:
#   python scripts/export_airtable_schema_snapshot.py
DALBERG_PROFILES_SCHEMA_PATH=config/dalberg_profiles_schema.json
# After a live Meta API fetch, write snapshot to disk (default 1). Set 0 in read-only images.
AIRTABLE_SCHEMA_AUTO_SAVE=1

AIRTABLE_INGESTION_CONFIG_PATH=config/airtable_ingestion.yaml

# --- Monitoring (EC2 only) ---------------------------------------------------
# Ship container logs to CloudWatch Logs (groups /mcp-dev/{api,worker,pipeline}
# must be pre-created AWS-side, KMS-encrypted; instance role needs
# logs:CreateLogStream + logs:PutLogEvents). Uncomment ON EC2 ONLY —
# with this set, EVERY docker compose invocation in this directory uses the
# awslogs overlay. See docs/logging-and-privacy.md.
#COMPOSE_FILE=docker-compose.yml:docker-compose.cloudwatch.yml
